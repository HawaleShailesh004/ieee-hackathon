# Optional: enables "suggest answers from my note". The app works without it.
# Accepts an OpenAI key, or an OpenRouter key with OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=
# Suggestions per client per hour (protects the key when the demo is shared). Default 10.
SUGGEST_LIMIT_PER_HOUR=10
